# Copy to apps/api/.env. Match the PostgreSQL port/user/password from root .env.
DATABASE_URL="postgresql://postgres:postgres_password_123@localhost:5432/clinica_san_rafael?schema=public"
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Generate locally: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Local reminder inbox: docker compose up -d mailpit; open http://localhost:8025
REMINDERS_ENABLED=true
NOTIFICATIONS_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Clínica San Rafael <recordatorios@sanrafael.test>"
# For an external SMTP provider, configure these locally (never commit secrets).
SMTP_USER=
SMTP_PASSWORD=

# Database backups (defaults: repository /backups, 02:00 local time).
# PG_BIN=C:\Program Files\PostgreSQL\18\bin
# BACKUP_DIR=C:\ruta\privada\respaldos-siges
BACKUP_TIME=02:00
