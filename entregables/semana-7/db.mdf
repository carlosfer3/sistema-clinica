BEGIN;

-- ============================================================
-- Clínica San Rafael: esquema PostgreSQL
-- Requiere PostgreSQL 11 o superior. Ejecutar sobre una base vacía.
-- ============================================================

-- ===== Tipos y funciones =====

CREATE TYPE rol_usuario AS ENUM (
    'admision', 'medico', 'enfermeria', 'laboratorio', 'cajero', 'gerencia', 'paciente'
);

-- Bloquea la operación indicada. Se usa en tablas donde no se borra
-- físicamente ningún registro (y en la bitácora, donde tampoco se modifica).
CREATE OR REPLACE FUNCTION fn_bloquear_operacion()
RETURNS trigger
LANGUAGE plpgsql
AS $$
BEGIN
    RAISE EXCEPTION 'La operación % no está permitida sobre la tabla %', TG_OP, TG_TABLE_NAME;
END;
$$;

-- ============================================================
-- NÚCLEO COMÚN
-- ============================================================

CREATE TABLE usuario (
    id            integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    rol           rol_usuario  NOT NULL,
    username      varchar(50)  NOT NULL UNIQUE,
    password_hash varchar(255) NOT NULL,
    nombres       varchar(100) NOT NULL,
    apellidos     varchar(100) NOT NULL,
    activo        boolean      NOT NULL DEFAULT true,
    creado_en     timestamptz  NOT NULL DEFAULT now()
);

CREATE TABLE especialidad (
    id     smallint    GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre varchar(80) NOT NULL UNIQUE
);

CREATE TABLE medico (
    id              integer     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    usuario_id      integer     NOT NULL UNIQUE REFERENCES usuario(id),
    especialidad_id smallint    NOT NULL REFERENCES especialidad(id),
    cmp             varchar(10) NOT NULL UNIQUE
);

CREATE TABLE servicio (
    id     integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    codigo varchar(20)  NOT NULL UNIQUE,
    nombre varchar(120) NOT NULL,
    tipo   varchar(15)  NOT NULL
           CHECK (tipo IN ('consulta', 'laboratorio', 'imagenes', 'procedimiento'))
);

CREATE TABLE bitacora_auditoria (
    id         bigint      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    usuario_id integer     NOT NULL REFERENCES usuario(id),
    fecha_hora timestamptz NOT NULL DEFAULT now(),
    accion     varchar(30) NOT NULL
               CHECK (accion IN ('leer', 'crear', 'editar', 'anular', 'acceso_denegado')),
    entidad    varchar(50) NOT NULL,
    entidad_id bigint,
    resultado  varchar(10) NOT NULL CHECK (resultado IN ('permitido', 'denegado'))
);

-- La bitácora es solo de inserción
CREATE TRIGGER trg_bitacora_solo_insercion
    BEFORE UPDATE OR DELETE ON bitacora_auditoria
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

-- ============================================================
-- M1. HISTORIA CLÍNICA ELECTRÓNICA
-- ============================================================

CREATE TABLE paciente (
    id               integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    usuario_id       integer      NOT NULL UNIQUE REFERENCES usuario(id),
    tipo_documento   varchar(12)  NOT NULL DEFAULT 'DNI'
                     CHECK (tipo_documento IN ('DNI', 'CE', 'PASAPORTE')),
    numero_documento varchar(15)  NOT NULL,
    fecha_nacimiento date         NOT NULL,
    sexo             char(1)      NOT NULL CHECK (sexo IN ('M', 'F')),
    telefono         varchar(20),
    correo           varchar(120),
    direccion        varchar(200),
    creado_en        timestamptz  NOT NULL DEFAULT now(),
    CONSTRAINT uq_paciente_documento UNIQUE (tipo_documento, numero_documento)
);

CREATE TABLE antecedente (
    id            integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    paciente_id   integer      NOT NULL REFERENCES paciente(id),
    tipo          varchar(30)  NOT NULL
                  CHECK (tipo IN ('personal', 'familiar', 'quirurgico', 'cronica')),
    descripcion   varchar(300) NOT NULL,
    desde         date,
    registrado_en timestamptz  NOT NULL DEFAULT now()
);

CREATE TABLE alergia (
    id          integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    paciente_id integer      NOT NULL REFERENCES paciente(id),
    sustancia   varchar(100) NOT NULL,
    reaccion    varchar(200)
);

CREATE TABLE cie10 (
    codigo      varchar(10)  PRIMARY KEY,
    descripcion varchar(250) NOT NULL
);

-- La tabla cita se crea antes que consulta y signos_vitales, porque ambas la referencian
-- (ver M2 más abajo). Por eso consultorio, horario_medico y cita se crean primero aquí.

-- ============================================================
-- M2. AGENDA Y CITAS
-- ============================================================

CREATE TABLE consultorio (
    id     smallint    GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre varchar(40) NOT NULL UNIQUE,
    activo boolean     NOT NULL DEFAULT true
);

CREATE TABLE horario_medico (
    id                integer  GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    medico_id         integer  NOT NULL REFERENCES medico(id),
    consultorio_id    smallint NOT NULL REFERENCES consultorio(id),
    dia_semana        smallint NOT NULL CHECK (dia_semana BETWEEN 1 AND 7),
    hora_inicio       time     NOT NULL,
    hora_fin          time     NOT NULL,
    duracion_cita_min smallint NOT NULL DEFAULT 20 CHECK (duracion_cita_min > 0),
    CONSTRAINT ck_horario_horas CHECK (hora_fin > hora_inicio),
    CONSTRAINT uq_horario_medico_dia_hora UNIQUE (medico_id, dia_semana, hora_inicio)
);

CREATE TABLE cita (
    id                integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    paciente_id       integer      NOT NULL REFERENCES paciente(id),
    medico_id         integer      NOT NULL REFERENCES medico(id),
    fecha_hora_inicio timestamptz  NOT NULL,
    fecha_hora_fin    timestamptz  NOT NULL,
    motivo            varchar(300),
    estado            varchar(15)  NOT NULL DEFAULT 'programada'
                      CHECK (estado IN ('programada', 'confirmada', 'reprogramada',
                                        'cancelada', 'atendida', 'no_asistio')),
    canal_origen      varchar(12)  NOT NULL DEFAULT 'presencial'
                      CHECK (canal_origen IN ('presencial', 'telefono', 'portal')),
    modalidad         varchar(10)  NOT NULL DEFAULT 'presencial'
                      CHECK (modalidad IN ('presencial', 'virtual')),
    enlace_virtual    varchar(300),
    llegada_en        timestamptz,
    creado_por        integer      NOT NULL REFERENCES usuario(id),
    creado_en         timestamptz  NOT NULL DEFAULT now(),
    CONSTRAINT ck_cita_horas CHECK (fecha_hora_fin > fecha_hora_inicio),
    CONSTRAINT ck_cita_enlace CHECK (modalidad = 'virtual' OR enlace_virtual IS NULL)
);

CREATE INDEX ix_cita_medico_fecha ON cita (medico_id, fecha_hora_inicio);
CREATE INDEX ix_cita_paciente_fecha ON cita (paciente_id, fecha_hora_inicio);

-- Evita la doble reserva: un médico no puede tener dos citas activas a la misma hora
CREATE UNIQUE INDEX uq_cita_medico_horario_activa
    ON cita (medico_id, fecha_hora_inicio)
    WHERE estado NOT IN ('cancelada', 'reprogramada');

CREATE TABLE notificacion (
    id              integer     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    cita_id         integer     NOT NULL REFERENCES cita(id),
    canal           varchar(10) NOT NULL CHECK (canal IN ('sms', 'correo', 'whatsapp')),
    plantilla       varchar(40) NOT NULL
                    CHECK (plantilla IN ('confirmacion', 'recordatorio_24h',
                                         'reprogramacion', 'cancelacion')),
    programada_para timestamptz NOT NULL,
    estado          varchar(10) NOT NULL DEFAULT 'pendiente'
                    CHECK (estado IN ('pendiente', 'enviado', 'fallido')),
    intentos        smallint    NOT NULL DEFAULT 0 CHECK (intentos >= 0),
    enviada_en      timestamptz
);

CREATE INDEX ix_notif_cola ON notificacion (estado, programada_para);

-- ============================================================
-- M1 (continuación): consulta, diagnósticos, recetas y signos vitales
-- ============================================================

CREATE TABLE consulta (
    id               integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    paciente_id      integer      NOT NULL REFERENCES paciente(id),
    medico_id        integer      NOT NULL REFERENCES medico(id),
    cita_id          integer      UNIQUE REFERENCES cita(id),
    fecha_hora       timestamptz  NOT NULL DEFAULT now(),
    motivo           varchar(300) NOT NULL,
    indicaciones     text,
    estado           varchar(10)  NOT NULL DEFAULT 'activo'
                     CHECK (estado IN ('activo', 'anulado')),
    motivo_anulacion varchar(300),
    anulado_por      integer      REFERENCES usuario(id),
    anulado_en       timestamptz,
    CONSTRAINT ck_consulta_anulacion CHECK (
        estado = 'activo'
        OR (motivo_anulacion IS NOT NULL AND anulado_por IS NOT NULL AND anulado_en IS NOT NULL)
    )
);

CREATE INDEX ix_consulta_paciente_fecha ON consulta (paciente_id, fecha_hora);

-- Una consulta se anula, nunca se elimina
CREATE TRIGGER trg_consulta_sin_borrado
    BEFORE DELETE ON consulta
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

CREATE TABLE consulta_diagnostico (
    id           integer     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    consulta_id  integer     NOT NULL REFERENCES consulta(id),
    cie10_codigo varchar(10) NOT NULL REFERENCES cie10(codigo),
    tipo         varchar(15) NOT NULL DEFAULT 'principal'
                 CHECK (tipo IN ('principal', 'secundario')),
    CONSTRAINT uq_diagnostico_consulta UNIQUE (consulta_id, cie10_codigo)
);

CREATE TABLE receta_item (
    id            integer      GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    consulta_id   integer      NOT NULL REFERENCES consulta(id),
    medicamento   varchar(150) NOT NULL,
    dosis         varchar(80)  NOT NULL,
    frecuencia    varchar(80)  NOT NULL,
    duracion_dias smallint     NOT NULL CHECK (duracion_dias > 0)
);

CREATE TABLE signos_vitales (
    id                  integer     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    paciente_id         integer     NOT NULL REFERENCES paciente(id),
    registrado_por      integer     NOT NULL REFERENCES usuario(id),
    cita_id             integer     REFERENCES cita(id),
    fecha_hora          timestamptz NOT NULL DEFAULT now(),
    presion_sistolica   smallint,
    presion_diastolica  smallint,
    frecuencia_cardiaca smallint,
    temperatura_c       numeric(4,1),
    saturacion_o2       smallint CHECK (saturacion_o2 BETWEEN 0 AND 100),
    peso_kg             numeric(5,2),
    talla_cm            numeric(5,1),
    estado              varchar(10) NOT NULL DEFAULT 'activo'
                        CHECK (estado IN ('activo', 'anulado')),
    motivo_anulacion    varchar(300),
    anulado_por         integer     REFERENCES usuario(id),
    anulado_en          timestamptz,
    CONSTRAINT ck_signos_anulacion CHECK (
        estado = 'activo'
        OR (motivo_anulacion IS NOT NULL AND anulado_por IS NOT NULL AND anulado_en IS NOT NULL)
    )
);

CREATE TRIGGER trg_signos_sin_borrado
    BEFORE DELETE ON signos_vitales
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

-- ============================================================
-- M3. LABORATORIO E IMÁGENES
-- ============================================================

CREATE TABLE orden (
    id            integer     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    consulta_id   integer     NOT NULL REFERENCES consulta(id),
    tipo          varchar(12) NOT NULL CHECK (tipo IN ('laboratorio', 'imagenes')),
    solicitada_en timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE orden_detalle (
    id               integer     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    orden_id         integer     NOT NULL REFERENCES orden(id),
    servicio_id      integer     NOT NULL REFERENCES servicio(id),
    valor            text,
    unidad           varchar(30),
    rango_referencia varchar(60),
    registrado_por   integer     REFERENCES usuario(id),
    registrado_en    timestamptz,
    CONSTRAINT uq_orden_detalle_servicio UNIQUE (orden_id, servicio_id),
    CONSTRAINT ck_resultado_completo CHECK (
        (valor IS NULL AND registrado_por IS NULL AND registrado_en IS NULL)
        OR (valor IS NOT NULL AND registrado_por IS NOT NULL AND registrado_en IS NOT NULL)
    )
);

-- ============================================================
-- M4. FACTURACIÓN Y CONVENIOS
-- ============================================================

CREATE TABLE convenio (
    id                smallint     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nombre            varchar(80)  NOT NULL UNIQUE,
    tipo              varchar(12)  NOT NULL CHECK (tipo IN ('particular', 'eps', 'soat')),
    copago_porcentaje numeric(5,2) NOT NULL DEFAULT 0
                      CHECK (copago_porcentaje BETWEEN 0 AND 100),
    activo            boolean      NOT NULL DEFAULT true
);

CREATE TABLE paciente_convenio (
    id            integer     GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    paciente_id   integer     NOT NULL REFERENCES paciente(id),
    convenio_id   smallint    NOT NULL REFERENCES convenio(id),
    numero_poliza varchar(40),
    vigente_desde date        NOT NULL,
    vigente_hasta date,
    CONSTRAINT uq_paciente_convenio_vigencia UNIQUE (paciente_id, convenio_id, vigente_desde),
    CONSTRAINT ck_vigencia CHECK (vigente_hasta IS NULL OR vigente_hasta >= vigente_desde)
);

CREATE TABLE tarifario (
    id          integer       GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    convenio_id smallint      NOT NULL REFERENCES convenio(id),
    servicio_id integer       NOT NULL REFERENCES servicio(id),
    precio      numeric(10,2) NOT NULL CHECK (precio >= 0),
    CONSTRAINT uq_tarifario_convenio_servicio UNIQUE (convenio_id, servicio_id)
);

CREATE TABLE comprobante (
    id               integer       GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    cita_id          integer       REFERENCES cita(id),
    paciente_id      integer       NOT NULL REFERENCES paciente(id),
    convenio_id      smallint      NOT NULL REFERENCES convenio(id),
    serie            varchar(4)    NOT NULL,
    numero           integer       NOT NULL,
    total            numeric(10,2) NOT NULL CHECK (total >= 0),
    copago           numeric(10,2) NOT NULL DEFAULT 0 CHECK (copago >= 0),
    estado           varchar(10)   NOT NULL DEFAULT 'emitido'
                     CHECK (estado IN ('emitido', 'pagado', 'anulado')),
    emitido_por      integer       NOT NULL REFERENCES usuario(id),
    emitido_en       timestamptz   NOT NULL DEFAULT now(),
    motivo_anulacion varchar(300),
    anulado_por      integer       REFERENCES usuario(id),
    anulado_en       timestamptz,
    CONSTRAINT uq_comprobante_serie_numero UNIQUE (serie, numero),
    CONSTRAINT ck_comprobante_anulacion CHECK (
        estado <> 'anulado'
        OR (motivo_anulacion IS NOT NULL AND anulado_por IS NOT NULL AND anulado_en IS NOT NULL)
    )
);

CREATE TRIGGER trg_comprobante_sin_borrado
    BEFORE DELETE ON comprobante
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

CREATE TABLE comprobante_detalle (
    id              integer       GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    comprobante_id  integer       NOT NULL REFERENCES comprobante(id),
    servicio_id     integer       NOT NULL REFERENCES servicio(id),
    cantidad        smallint      NOT NULL DEFAULT 1 CHECK (cantidad > 0),
    precio_unitario numeric(10,2) NOT NULL CHECK (precio_unitario >= 0)
);

CREATE TRIGGER trg_antecedente_sin_borrado
    BEFORE DELETE ON antecedente
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

CREATE TRIGGER trg_alergia_sin_borrado
    BEFORE DELETE ON alergia
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

CREATE TRIGGER trg_consulta_diagnostico_sin_borrado
    BEFORE DELETE ON consulta_diagnostico
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

CREATE TRIGGER trg_receta_item_sin_borrado
    BEFORE DELETE ON receta_item
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

CREATE TRIGGER trg_orden_sin_borrado
    BEFORE DELETE ON orden
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

CREATE TRIGGER trg_orden_detalle_sin_borrado
    BEFORE DELETE ON orden_detalle
    FOR EACH ROW EXECUTE FUNCTION fn_bloquear_operacion();

COMMIT;