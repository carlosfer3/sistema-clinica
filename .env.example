# Configuración de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
POSTGRES_DB=clinica_san_rafael
POSTGRES_PORT=5432

# Configuración de Redis (BullMQ)
REDIS_PORT=6379

# URL de conexión para Prisma / NestJS
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"
REDIS_HOST="localhost"

# Full application: docker compose --profile app up --build -d
# Generate a secret of at least 32 characters before starting the API.
JWT_SECRET=
API_PORT=3000
WEB_PORT=8080
REMINDERS_ENABLED=false
NOTIFICATIONS_ENABLED=false
